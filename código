// Em qual posicao do vetor cada musica comeca (a ultima e o fim da musica 4)
const int inicio[6] = { 0, 88, 153, 247, 278, 375 };

// ---------------- Variaveis ----------------
int musicaEscolhida = 0;    // musica selecionada no menu (0 a 4)
int musicaAnterior  = -1;   // ajuda a atualizar o LCD so quando muda
bool parar = false;         // vira true quando o STOP e apertado

// Nivel lido no pino quando o botao esta SOLTO (descoberto no setup)
int soltoStart, soltoPause, soltoSair;

// ============================================================
void setup() {
  // INPUT_PULLUP: o botao liga o pino ao GND (solto = HIGH, apertado = LOW)
  pinMode(btnStart, INPUT_PULLUP);
  pinMode(btnPause, INPUT_PULLUP);
  pinMode(btnSair,  INPUT_PULLUP);

  // Descobre como os botoes estao ligados: com NENHUM botao apertado,
  // guarda o nivel de cada pino. "Apertado" = nivel diferente desse.
  // (por isso nao aperte nada nos primeiros instantes da simulacao)
  delay(100);
  soltoStart = digitalRead(btnStart);
  soltoPause = digitalRead(btnPause);
  soltoSair  = digitalRead(btnSair);

  pinMode(ledRed, OUTPUT);
  pinMode(ledGreen, OUTPUT);
  pinMode(buzzer, OUTPUT);

  lcd.begin(16, 2);

  lcd.print("Reprodutor de");
  lcd.setCursor(0, 1);
  lcd.print("Musicas");
  delay(1500);
}

// ============================================================
void loop() {
  // ----- MENU -----
  // le o potenciometro (0 a 1023) e transforma em 0 a 4
  musicaEscolhida = map(analogRead(pot), 0, 1024, 0, 5);

  // so redesenha o LCD quando a musica muda (evita ficar piscando)
  if (musicaEscolhida != musicaAnterior) {
    musicaAnterior = musicaEscolhida;
    lcd.clear();
    lcd.print("Musica ");
    lcd.print(musicaEscolhida + 1);
    lcd.print("/5");
    lcd.setCursor(0, 1);
    lcd.print("> ");
    lcd.print(nomes[musicaEscolhida]);
  }

  // botao PLAY apertado -> toca a musica escolhida
  if (apertado(btnStart)) {
    esperarSoltar(btnStart);    // espera soltar o botao (anti-ruido)
    tocarMusica(musicaEscolhida);
    musicaAnterior = -1;        // forca o LCD a mostrar o menu de novo
  }
}

// ============================================================
// Toca uma musica inteira (ou ate pausar)
void tocarMusica(int m) {
  parar = false;

  lcd.clear();
  lcd.print("Tocando:");
  lcd.setCursor(0, 1);
  lcd.print(nomes[m]);
  digitalWrite(ledGreen, HIGH);
  digitalWrite(ledRed, LOW);

  // passa por todas as notas da musica m
  for (int i = inicio[m]; i < inicio[m + 1]; i++) {
    if (parar) break;

    // pgm_read_word le um valor guardado na memoria FLASH
    int nota    = pgm_read_word(&notas[i]);
    int duracao = pgm_read_word(&duracoes[i]);

    if (nota == 0) {
      noTone(buzzer);                       // 0 = silencio (pausa na musica)
    } else {
      tone(buzzer, nota, duracao * 0.9);    // toca a nota
    }

    esperar(duracao);                       // espera a nota acabar
  }

  // terminou ou apertou STOP: volta ao menu
  noTone(buzzer);
  digitalWrite(ledGreen, LOW);
  digitalWrite(ledRed, LOW);
}

// ============================================================
// Espera "ms" milissegundos, mas continua olhando os botoes
// (por isso nao usamos delay: com delay nao daria para pausar)
void esperar(int ms) {
  unsigned long fim = millis() + ms;

  while (millis() < fim && !parar) {
    if (apertado(btnPause)) {
      esperarSoltar(btnPause);
      pausar();
    }
    if (apertado(btnSair)) {
      esperarSoltar(btnSair);
      parar = true;
    }
  }
}

// ============================================================
// Fica aqui dentro ate apertar continua ou parar
void pausar() {
  noTone(buzzer);
  digitalWrite(ledGreen, LOW);
  digitalWrite(ledRed, HIGH);

  lcd.setCursor(0, 0);
  lcd.print("Pausado:        ");

  while (true) {
    if (apertado(btnStart)) {               // PLAY: despausa a musica
      esperarSoltar(btnStart);
      digitalWrite(ledRed, LOW);
      digitalWrite(ledGreen, HIGH);
      lcd.setCursor(0, 0);
      lcd.print("Tocando:        ");
      return;
    }
    if (apertado(btnSair)) {                // STOP: volta ao menu
      esperarSoltar(btnSair);
      parar = true;
      return;
    }
  }
}

// ============================================================
// Devolve true se o botao desse pino esta apertado agora
bool apertado(int pino) {
  int solto = soltoStart;
  if (pino == btnPause) solto = soltoPause;
  if (pino == btnSair)  solto = soltoSair;
  return digitalRead(pino) != solto;
}

// ============================================================
// Espera o botao ser solto (com um pequeno tempo para filtrar ruido)
void esperarSoltar(int pino) {
  delay(50);
  while (apertado(pino)) { }
  delay(50);
}
